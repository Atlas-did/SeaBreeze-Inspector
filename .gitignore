# =============================================================================
# Offshore Wind UAV-Arm — .gitignore
# =============================================================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environment
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project-specific
data/processed/logs/*.csv
data/processed/*.png
# 运行日志已从数据集目录迁出(P1-3b): 日志不再写进 data/processed
data/logs/
data/omnisim/
data/weights/*.pt
!data/weights/.gitkeep
!data/weights/.ci-placeholder.pt

# Environment
.env
.env.local

# Test output
.pytest_cache/
.coverage
htmlcov/
*.coverage

# Jupyter
.ipynb_checkpoints/

# Flight logs (keep .gitkeep for CI directory check)
logs/*
!logs/.gitkeep

# Internal docs (keep only public-facing README/LICENSE/CONTRIBUTING)
docs/*.md
!docs/API_INTERFACE.md
!docs/ARCHITECTURE_DECISIONS.md
!docs/EKF_DERIVATION.md
!docs/KINEMATICS_DERIVATION.md
!docs/TRAJECTORY_ALGORITHM.md
!docs/TUNING_GUIDE.md
!docs/HARDWARE.md
!docs/SOFTWARE.md
!docs/SIM_GUIDE.md
# HIL 协议与记录模板是**交付物**(审计第三步的执行依据), 不是内部笔记:
# 未加此例外时 docs/*.md 会把它挡住, 导致"拆桨测试协议"永远提交不进仓库。
!docs/HIL_PROTOCOL.md
!docs/TESTING.md
HANDOFF.md

# Internal review/evidence docs (kept off the public repo)
REVIEW_VERDICT.md
research/README.md
research/EVIDENCE_MAP.md
research/专项/GAP_TRACKER.md

data/raw/
runs/detect/
seabreeze-3d-sim/train_v3.py
scripts/watch_training.py
*.zip

# ---------------------------------------------------------------------------
# Derived datasets (2026-10-06 复核建议)
# images/ 实测 696 MB / 3780 文件 —— 一旦入库就永久留在 git 历史里，事后
# `git rm --cached` 也删不掉。故按目录忽略图像与标签子树，但**保留**数据集
# 根目录下的小体积 provenance 产物（manifests / split_summary /
# adjudication_decisions / ood_test_EVAL_LOCK_final.json）—— 第三方要靠它们
# 才能验证"OOD 只测了一次"这类声明。
# ---------------------------------------------------------------------------
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/labels/
datasets/**/ood_test/

# 误建嵌套输出：make_v5_2_split.py 的 --out 默认是相对路径 'v5_2'，
# 在 research/v5_2/ 作 CWD 运行时就会生成 research/v5_2/v5_2/。
# 实测 6085 文件 / 618.6 MB（3040 张图）。派生数据、可再生，不入库。
research/v5_2/v5_2/

# 编辑器/手改留下的备份快照（如加 BOM 前的 *.bak-nobom）—— 版本历史已在 git 里
*.bak
*.bak-*
*.orig

